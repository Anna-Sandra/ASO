NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3007

# Local: mongodb://127.0.0.1:27017/brewmart  |  Atlas: use your SRV string; add your IP under Atlas → Network Access.
# Login/refresh return 503 if this host is unreachable (firewall, wrong IP allow list, or MongoDB not running).
MONGODB_URI=mongodb://127.0.0.1:27017/brewmart

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters

COOKIE_SECURE=false

# ---- Email: use either Gmail (A) or generic SMTP (B), not both at once ----
# For Gmail, set EMAIL_FROM to the same account, e.g. Campus Mart <you@gmail.com>
EMAIL_FROM=Campus Market <no-reply@example.com>

# (A) Gmail + Nodemailer: enable 2-Step Verification, create an App password (Mail), leave SMTP_HOST empty
# EMAIL_USER=you@gmail.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx

# (B) SMTP (any provider, or smtp.gmail.com + your address + app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Platform share of each product line (buyer pays list price; fee taken from line gross before seller share).
# Example: price Ghc 10, PLATFORM_COMMISSION_PERCENT=7 → platform Ghc 0.70, seller Ghc 9.30 on that line.
PLATFORM_COMMISSION_PERCENT=7

# Local dev only: true = skip verify-email flow (register auto-verifies; login allowed)
AUTH_SKIP_EMAIL_VERIFICATION=false

# Local demo only: true = buyers can rate products without a paid order (still one review per buyer per product).
REVIEWS_SKIP_VERIFIED_PURCHASE=false

# Optional. When set, all `/api/admin` requests must send header `X-Admin-Secret: <same value>`.
# Mirror in the frontend as `REACT_APP_ADMIN_API_KEY` if you use this.
ADMIN_ACCESS_SECRET=

# Fixed platform admin: on every API start, this user is created (or updated) with role=admin
# and this exact password, so you always sign in with the same email + password. Replace the email
# with yours; set a new strong secret for BOOTSTRAP_ADMIN_PASSWORD — do not use the example in production.
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_PASSWORD=Adm!9kX2#mQ7vL
