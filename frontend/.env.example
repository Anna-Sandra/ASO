PORT=3007
# Local dev: **leave empty** so the browser calls `/api/*` on the CRA dev server; `setupProxy.js` forwards to
# http://localhost:4000 (set REACT_APP_PROXY_TARGET to change). Avoids CORS and works when you only open :3007.
# Production / hosted SPA: set to your public API origin, e.g. https://YOUR-API.onrender.com — then rebuild.
# REACT_APP_API_URL=http://localhost:4000

# Admin API access uses an httpOnly cookie set at sign-in (credentials: include). Do not put ADMIN_ACCESS_SECRET here.
